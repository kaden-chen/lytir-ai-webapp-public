{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: vite",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:\\s+http"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "verify",
      "dependsOrder": "sequence",
      "dependsOn": [
        "typecheck",
        "lint",
        "format:check",
        "lint:md",
        "test",
        "build"
      ],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "format:check",
      "type": "npm",
      "script": "format:check",
      "problemMatcher": []
    },
    {
      "label": "lint:md",
      "type": "npm",
      "script": "lint:md",
      "problemMatcher": []
    },
    { "label": "test", "type": "npm", "script": "test", "problemMatcher": [] },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"]
    }
  ]
}
