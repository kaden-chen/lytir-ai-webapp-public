# Copy this file to .env.local and adjust values for your environment.
# Only VITE_-prefixed values reach the browser, and they are inlined at build
# time. Never put a secret here.

# Application version shown in the interface.
VITE_APP_VERSION=0.9.0

# Firebase web configuration, from Project settings > Your apps. These are
# public by design and ship in the bundle; protection comes from the
# authorized-domains list and from token validation at the API edge.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Basemap style URLs, one per colour scheme. CARTO's Positron and Dark Matter
# are the styles most data interfaces are built on, and they need no API key.
# They label in `name_en` rather than the local script, so a world view is
# readable without the application rewriting any labels.
#
# Two conditions on anything repointed here. It must serve the
# `Noto Sans Regular` fontstack, or the cluster counts lose their glyphs. And
# it must be judged at street zoom as well as world zoom: a style can separate
# land from water on a globe and still render a freeway indistinguishable from
# a driveway.
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# One full URL per API, so an endpoint can be repointed without a release.
# These address the API edge, never the backend directly.
VITE_API_DIAG_URL=
VITE_API_EARTHQUAKES_URL=
VITE_API_AI_QA_URL=
